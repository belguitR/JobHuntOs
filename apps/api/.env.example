JOB_HUNT_ENVIRONMENT=development
JOB_HUNT_DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
JOB_HUNT_GOOGLE_CLIENT_ID=<google-oauth-web-client-id>
JOB_HUNT_SESSION_SIGNING_KEY=<replace-with-at-least-32-random-characters>
JOB_HUNT_SESSION_COOKIE_SECURE=false
