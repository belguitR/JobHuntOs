{
  "manifest_version": 3,
  "name": "Job Hunt OS Capture",
  "version": "1.0.0",
  "description": "Save a job or LinkedIn contact to your local country workspace after reviewing the details.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["https://*.greenhouse.io/*", "https://jobs.lever.co/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Save to Job Hunt OS" }
}
